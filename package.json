{
  "name": "kyxos-render",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm --filter @kyxos/viewer build && pnpm --filter @kyxos/playground build",
    "build:pages": "pnpm build && node scripts/build-pages.mjs",
    "dev": "pnpm --filter @kyxos/playground dev",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --filter @kyxos/viewer typecheck && pnpm --filter @kyxos/playground typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
