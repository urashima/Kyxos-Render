{
  "name": "kyxos-render",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:pages": "pnpm build && node scripts/build-pages.mjs",
    "dev": "pnpm --filter @kyxos/studio dev",
    "dev:viewer": "pnpm --filter @kyxos/playground dev",
    "dev:public": "pnpm --filter @kyxos/public-viewer dev",
    "lint": "eslint .",
    "format:check": "prettier --check package.json",
    "format": "prettier --write package.json",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:contract && pnpm test:integration && pnpm verify:boundaries && pnpm verify:licenses && pnpm verify:contracts && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
